---
import Base from '../../layouts/Base.astro';
import Grid from '../../components/Grid.astro';
import { avatarUrl, getUser, submissionsByUser, type Submission } from '../../lib/db';
import { isClosed, localToday, MISS, puzzleDate, scoreLabel, shortDate } from '../../lib/wordle';

const db = Astro.locals.runtime.env.DB;
const user = await getUser(db, Astro.params.id ?? '');
if (!user) return Astro.rewrite('/404');

const me = Astro.locals.user?.discord_id === user.discord_id;
const now = Date.now();
const today = localToday(Astro.cookies.get('tz')?.value, now);
const subs = await submissionsByUser(db, user.discord_id); // newest first
const byNo = new Map(subs.map((s) => [s.puzzle_no, s]));
const solved = subs.filter((s) => s.score < MISS);
const label = (n: number) => n.toLocaleString('en-US');

// ---- Headline numbers ------------------------------------------------------
const winRate = subs.length ? Math.round((solved.length / subs.length) * 100) : 0;
const average = solved.length ? solved.reduce((t, s) => t + s.score, 0) / solved.length : null;
const hardGames = subs.filter((s) => s.hard_mode).length;

// Streaks: wins on consecutive puzzles. The current one counts only if the
// latest win is today's or yesterday's puzzle.
const won = new Set(solved.map((s) => s.puzzle_no));
let best = 0;
for (const n of won) {
  if (won.has(n - 1)) continue;
  let len = 1;
  while (won.has(n + len)) len++;
  best = Math.max(best, len);
}
let current = 0;
const latest = subs[0];
if (latest && latest.score < MISS && latest.puzzle_no >= today - 1) {
  while (won.has(latest.puzzle_no - current)) current++;
}

// ---- Distribution (latest game highlighted, like Wordle) --------------------
const dist = [1, 2, 3, 4, 5, 6, MISS].map((score) => ({
  score,
  count: subs.filter((s) => s.score === score).length,
}));
const top = Math.max(1, ...dist.map((d) => d.count));

// ---- Calendar: the last 10 weeks, Monday first -------------------------------
const WEEKS = 10;
const weekday = (new Date(`${puzzleDate(today)}T00:00:00Z`).getUTCDay() + 6) % 7; // Mon = 0
const start = today - weekday - 7 * (WEEKS - 1);
const days = Array.from({ length: WEEKS * 7 }, (_, i) => start + i);
const tone = (s?: Submission) => (!s ? 'none' : s.score === MISS ? 'b' : s.score <= 3 ? 'g' : 'y');
const recent = days.filter((n) => n <= today && byNo.has(n)).length;

// ---- Opener and best game (closed puzzles only, so nothing open is spoiled) --
const closed = subs.filter((s) => isClosed(s.puzzle_no, now));
const openers = new Map<string, Submission[]>();
for (const s of closed) {
  const first = s.guesses.split(',')[0];
  openers.set(first, [...(openers.get(first) ?? []), s]);
}
const [opener, openerGames] = [...openers].sort((a, b) => b[1].length - a[1].length)[0] ?? [null, []];
const openerHits = (c: 'g' | 'y') =>
  openerGames.reduce((t, s) => t + [...s.colors.split(',')[0]].filter((x) => x === c).length, 0) /
  Math.max(1, openerGames.length);

const bestGame = [...solved].sort((a, b) => a.score - b.score || b.puzzle_no - a.puzzle_no)[0];
const bestRevealed = bestGame && isClosed(bestGame.puzzle_no, now);
const answerOf = (s: Submission) => s.guesses.split(',').at(-1)!;

const since = subs.length ? shortDate(subs[subs.length - 1].puzzle_no) : null;
---

<Base title={user.name}>
  <div class="stack">
    <header class="profile-head">
      <img class="avatar avatar--xl" src={avatarUrl(user, 256)} alt="" width="104" height="104" />
      <div class="profile-head__text">
        <p class="eyebrow">{me ? 'Your profile' : 'Player'}</p>
        <h1 class="scatter">
          <span class="scatter__line scatter__line--l" style="--rot:-1deg">{user.name}</span>
        </h1>
        <p class="profile-head__meta annotation">
          {
            since
              ? `Playing since ${since} · ${subs.length} ${subs.length === 1 ? 'game' : 'games'}${hardGames ? ` · ${hardGames} in hard mode` : ''}`
              : 'No games yet'
          }
        </p>
      </div>
      {
        me && (
          <div class="profile-head__actions">
            <form method="post" action="/auth/logout">
              <button class="button button--ghost button--small" type="submit">
                Log out
              </button>
            </form>
          </div>
        )
      }
    </header>

    <dl class="stats">
      <div class="stat"><dt class="annotation">Played</dt><dd>{subs.length}</dd></div>
      <div class="stat"><dt class="annotation">Win %</dt><dd>{winRate}</dd></div>
      <div class="stat"><dt class="annotation">Avg guesses</dt><dd>{average ? average.toFixed(2) : '–'}</dd></div>
      <div class:list={['stat', current > 0 && 'stat--hot']}>
        <dt class="annotation">Streak</dt><dd>{current}</dd>
      </div>
      <div class="stat"><dt class="annotation">Best streak</dt><dd>{best}</dd></div>
    </dl>

    <div class="profile-grid">
      <section>
        <div class="section-head">
          <h2 class="display display--section">Guess distribution</h2>
          {latest && <span class="annotation">last game in green</span>}
        </div>
        <ol class="dist">
          {
            dist.map((d) => (
              <li class:list={['dist__row', latest?.score === d.score && 'dist__row--hi']}>
                <span class="dist__label">{d.score === MISS ? 'X' : d.score}</span>
                <span class="dist__bar" style={`--w:${(d.count / top) * 100}%`}>
                  {d.count}
                </span>
              </li>
            ))
          }
        </ol>
      </section>

      <section>
        <div class="section-head">
          <h2 class="display display--section">Last {WEEKS} weeks</h2>
          <span class="annotation tabular">{recent} played</span>
        </div>
        <div class="cal-wrap">
          <div class="cal-days annotation" aria-hidden="true">
            {['Mon', '', 'Wed', '', 'Fri', '', 'Sun'].map((d) => <span>{d}</span>)}
          </div>
          <div class="calendar" role="list">
            {
              days.map((n) => {
                const s = byNo.get(n);
                const title = `Wordle ${label(n)} · ${shortDate(n)}${s ? ` · ${scoreLabel(s.score)}` : ' · not played'}`;
                const cls = ['cal', `cal--${tone(s)}`, n > today && 'cal--future', n === today && 'cal--today'];
                return s ? (
                  <a class:list={cls} href={`/puzzle/${n}`} title={title} role="listitem">
                    {s.score === MISS ? 'X' : s.score}
                  </a>
                ) : (
                  <span class:list={cls} title={title} role="listitem" />
                );
              })
            }
          </div>
        </div>
        <ul class="legend annotation">
          <li><span class="cal cal--g"></span>1–3</li>
          <li><span class="cal cal--y"></span>4–6</li>
          <li><span class="cal cal--b"></span>missed</li>
          <li><span class="cal cal--none"></span>didn't play</li>
        </ul>
      </section>

      <section>
        <div class="section-head">
          <h2 class="display display--section">Favorite opener</h2>
        </div>
        {
          opener ? (
            <>
              <Grid colors="bbbbb" guesses={opener} size="md" label={`Favorite opener: ${opener.toUpperCase()}`} />
              <p class="fact__note">
                Used in {openerGames.length} of {closed.length} finished games. On average it lights up{' '}
                {openerHits('g').toFixed(1)} green and {openerHits('y').toFixed(1)} yellow.
              </p>
            </>
          ) : (
            <p class="empty">Shows up once a puzzle they played has closed.</p>
          )
        }
      </section>

      <section>
        <div class="section-head">
          <h2 class="display display--section">Best game</h2>
          {bestGame && <span class="annotation">{scoreLabel(bestGame.score)}</span>}
        </div>
        {
          bestGame ? (
            <>
              <Grid colors={bestGame.colors} guesses={bestRevealed ? bestGame.guesses : undefined} size="md" />
              <p class="fact__note">
                <a href={`/puzzle/${bestGame.puzzle_no}`}>Wordle {label(bestGame.puzzle_no)}</a>
                {`, ${shortDate(bestGame.puzzle_no)}${bestGame.hard_mode ? ', in hard mode' : ''}.`}
              </p>
            </>
          ) : (
            <p class="empty">No wins yet.</p>
          )
        }
      </section>
    </div>

    <section>
      <div class="section-head">
        <h2 class="display display--section">History</h2>
        {subs.length > 30 && <span class="annotation">latest 30</span>}
      </div>
      {
        subs.length ? (
          <ul class="history">
            {subs.slice(0, 30).map((s) => (
              <li class="history__item">
                <Grid colors={s.colors} />
                <div>
                  <a class="history__title" href={`/puzzle/${s.puzzle_no}`}>
                    Wordle {label(s.puzzle_no)}
                  </a>
                  <div class="history__meta">
                    <span class="annotation">{shortDate(s.puzzle_no)}</span>
                    {isClosed(s.puzzle_no, now) && s.score < MISS && (
                      <span class="history__answer">{answerOf(s).toUpperCase()}</span>
                    )}
                    {s.hard_mode ? <span class="hard">Hard</span> : null}
                  </div>
                </div>
                <span class="history__score">{scoreLabel(s.score)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No games yet.</p>
        )
      }
    </section>
  </div>
</Base>
