{
  "name": "wordler",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "check": "astro check",
    "words": "node scripts/build-words.mjs",
    "db:migrate:local": "wrangler d1 migrations apply wordler --local",
    "db:migrate:remote": "wrangler d1 migrations apply wordler --remote",
    "deploy": "astro build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20260116.0",
    "typescript": "^5.7.3",
    "wrangler": "4.59.2"
  }
}
